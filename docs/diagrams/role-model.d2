# Roles & Responsibilities
# Constitutional layer on top · aligned propose/decide pairs · bidirectional flow

direction: down

classes: {
  constitutional: {
    style.fill: "#FEF3C7"
    style.stroke: "#D97706"
    style.bold: true
    style.font-size: 16
  }
  proposer-side: {
    style.fill: "#ECFDF5"
    style.stroke: "#16A34A"
    style.bold: true
    style.font-size: 15
  }
  decider-side: {
    style.fill: "#EFF6FF"
    style.stroke: "#2563EB"
    style.bold: true
    style.font-size: 15
  }
  role-propose: {
    style.fill: "#F0FDF4"
    style.stroke: "#16A34A"
    style.font-size: 14
  }
  role-decide: {
    style.fill: "#DBEAFE"
    style.stroke: "#2563EB"
    style.font-size: 14
  }
  delegator: {
    style.fill: "#EFF6FF"
    style.stroke: "#3B82F6"
    style.font-size: 14
  }
  flow-out: {
    style.fill: "#F0FDF4"
    style.stroke: "#16A34A"
    style.font-size: 14
    style.bold: true
  }
  flow-in: {
    style.fill: "#EFF6FF"
    style.stroke: "#2563EB"
    style.font-size: 14
    style.bold: true
  }
  guardrail: {
    style.stroke: "#D97706"
    style.font-size: 13
  }
  rule: {
    style.fill: "#F8FAFC"
    style.stroke: "#CBD5E1"
    style.font-size: 13
  }
  pair-link: {
    style.stroke: "#64748B"
    style.font-size: 12
  }
  layout: {
    style.fill: transparent
    style.stroke: transparent
  }
}

title: {
  label: |md
    # Distributed Roles & Power
    *No alternativeless, self-defining entities*
  |
  near: top-center
  style.font-size: 20
}

constitution: "Constitutional Layer\n(timelines · roles · guardrails · accountability)" {
  class: constitutional
}

board: "" {
  class: layout
  direction: right

  proposing: "Proposing Side\n(compete)" {
    class: proposer-side
    direction: down

    framework: "Framework Designers\n· Complete annual strategies\n· Disclosure template (identity · COI · rationale)" {
      class: role-propose
    }

    vendor: "Vendors\n· Project proposals within category lanes\n· Transparency levels + reputation" {
      class: role-propose
    }

    admin: "Administrators\n· Operational support (milestones · reporting)\n· Compete for DRep trust (not proposer fees)" {
      class: role-propose
    }

    auditor: "Auditors\n· Register expertise + pricing\n· Independent milestone verification" {
      class: role-propose
    }

    compete: ">>\ncompete for\napproval" {
      class: flow-out
    }

    framework -> vendor -> admin -> auditor -> compete {
      style.opacity: 0
    }
  }

  deciding: "Deciding Side · DReps\n(vote)" {
    class: decider-side
    direction: down

    confirm: "<<\nconfirm the\nquality/demand" {
      class: flow-in
    }

    d1: "Framework preference\n(Q4)" { class: role-decide }
    d2: "Category preference\n(quarterly)" { class: role-decide }
    d3: "Admin trust allocation\n(Q4)" { class: role-decide }
    d4: "Final confirmation\n+ closure" { class: role-decide }

    confirm -> d1 -> d2 -> d3 -> d4 {
      style.opacity: 0
    }
  }
}

delegator: "ADA Holders (delegators)\n· Choose DReps by expertise & signals" {
  class: delegator
}

rules: "Separation rules:\n· No self-defining monopoly roles\n· No same entity as vendor + admin + auditor in one category\n· Treasury guardrails amended separately from annual budget" {
  class: rule
  near: bottom-center
}

constitution -> board

# Constitutional guardrails fan out left and right
constitution -> board.proposing: guardrails { class: guardrail }
constitution -> board.deciding: guardrails { class: guardrail }

# Four paired decision domains
board.proposing.framework -> board.deciding.d1 { class: pair-link }
board.proposing.vendor -> board.deciding.d2 { class: pair-link }
board.proposing.admin -> board.deciding.d3 { class: pair-link }
board.proposing.auditor -> board.deciding.d4 { class: pair-link }

board.deciding -> delegator
